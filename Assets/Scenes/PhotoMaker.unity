GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  serializedVersion: 6
  m_Component:
  - component: {fileID: 1660397186}
  - component: {fileID: 1660397185}
  m_Layer: 0
  m_Name: PhotoMakerTutorial
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &1660397185
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1660397184}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: faebd17381c790a4da402b2f12f51708, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - Title: Welcome & Basics
    Body: Hey there! Welcome to the Photo Maker! Let's take a quick tour. If you
      need to go back, tap the arrow in the top-left corner.
    PreviewImage: {fileID: 0}
  - Title: Selecting Characters
    Body: The text like 'Trainer 1' shows your currently selected character. Use
      the 'Previous' and 'Next' buttons to cycle through characters in the scene.
    PreviewImage: {fileID: 21300000, guid: 33ddb899cef14e04db405d04148c010e, type: 3}
  - Title: Adding & Removing
    Body: Tap 'Add' to bring another character into the scene. To remove one, select
      them first, then tap 'Remove'.
    PreviewImage: {fileID: 21300000, guid: 9786a2c29b3632941901cf8645783e96, type: 3}
  - Title: Changing Clothes (Manual)
    Body: Tap 'Open Clothes Menu' to browse and select different outfits for your
      chosen character. This is the standard way to change clothes.
    PreviewImage: {fileID: 21300000, guid: 1cd736cae0dbd3d4fb0355a1f22d4b6d, type: 3}
  - Title: Changing Clothes (Advanced)
    Body: 'Advanced: Paste a Base64 clothing code into the text field and tap ''Initialize''
      to apply it instantly. This is optional; the ''Open Clothes Menu'' is the main
      way.'
    PreviewImage: {fileID: 21300000, guid: 1bd0832ed2ed9e741833d24edaba512a, type: 3}
  - Title: Poses & Animations
    Body: 'Use the dropdown menu (showing ''ani_idle...'') to choose different animations
      or poses for your selected character.

      Sadly the animation names are
      not super intuitive, but with a bit of sperimentation you''ll find the perfect
      pose for your shot!'
    PreviewImage: {fileID: 21300000, guid: 32eb19bdbfb412747b13997141d23a1f, type: 3}
  - Title: Moving Characters
    Body: 'These top-right controls move the selected character! Use the circular
      pads for left/right/forward/back movement.

      Use the horizontal pad to
      rotate the selected character left or right.'
    PreviewImage: {fileID: 21300000, guid: 6238b9447842e604e88753e964123780, type: 3}
  - Title: Movement Sensitivity
    Body: "The horizontal slider adjusts the sensitivity \u2013 how quickly the character
      responds to the movement and rotation controls."
    PreviewImage: {fileID: 21300000, guid: a3a6d932e7cfbd3478cb71a8b55cc92d, type: 3}
  - Title: Facing the Camera
    Body: Want your character looking right at the viewpoint? Select them and tap
      'Look at Camera'.
    PreviewImage: {fileID: 21300000, guid: 8d9b44fb915f9c144b0925de60511005, type: 3}
  - Title: Saving And Loading Your Scene
    Body: 'Created a setup you love? Tap ''Save'' to store the current arrangement
      of characters, their poses, positions, and outfits.

      You can bring back
      a previously saved setup anytime by tapping the ''Load'' button.'
    PreviewImage: {fileID: 21300000, guid: 38a743d6a83082143af08632c0333575, type: 3}
  - Title: Taking the Picture!
    Body: Ready? Tap the Camera icon in the bottom left corner. This takes the picture
      and saves it for you! Now go experiment and have fun!
    PreviewImage: {fileID: 21300000, guid: 7a3e7262bb4b3cc4493db0b5d51638c7, type: 3}
  triggerOnlyOnce: 1
